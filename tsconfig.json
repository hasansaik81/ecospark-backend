{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node", // এটি ঠিক আছে
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".", 
    "paths": {
      "@/*": ["src/*"],  // 👈 এটি যোগ করুন
      "@prisma-generated/*": ["generated/prisma/*"]
    }
  },
  "include": [
    "src/**/*",
    "generated/prisma/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}